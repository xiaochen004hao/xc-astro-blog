---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import AiSummary from "@/components/blog/AiSummary.astro";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
	content: CollectionEntry<"post">;
	readingTime: string;
	wordCount?: number;
}

const {
	content: { data },
	readingTime,
	wordCount = 0,
} = Astro.props;

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long",
};
---

{
	data.coverImage && (
		<div class="mb-6 aspect-video" data-reveal>
			<Image
				alt={data.coverImage.alt}
				loading="eager"
				decoding="async"
				sizes="(max-width: 768px) 100vw, 748px"
				src={data.coverImage.src}
				width={748}
				height={420}
			/>
		</div>
	)
}
{data.draft ? <span class="text-base text-red-500">(Draft)</span> : null}
<h1 id="blog-title" class="title" data-reveal>
	{data.title}
</h1>
<div
	class="text-muted mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm"
	data-reveal
	data-reveal-delay="80"
>
	<span>发布于</span>
	<span class="text-global-text font-semibold">
		<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} />
	</span>
	<span class="text-muted/50 select-none" aria-hidden="true">|</span>
	<span>{readingTime}</span>
	<span class="text-muted/50 select-none" aria-hidden="true">|</span>
	<span>{wordCount} 字</span>
	{
		data.updatedDate && (
			<>
				<span class="text-muted/50 select-none" aria-hidden="true">
					|
				</span>
				<span class="bg-quote/5 text-quote rounded-lg px-2.5 py-1 text-xs">
					更新于：
					<FormattedDate date={data.updatedDate} dateTimeOptions={dateTimeOptions} />
				</span>
			</>
		)
	}
</div>
{
	!!data.tags?.length && (
		<div class="mt-2" data-reveal data-reveal-delay="160">
			<svg
				aria-hidden="true"
				class="inline-block h-6 w-6"
				fill="none"
				focusable="false"
				stroke="var(--color-muted)"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.5"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" />
				<path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />
				<path d="M6 9h-.01" />
			</svg>
			{data.tags.map((tag, i) => (
				<>
					{/* prettier-ignore */}
					<span class="contents">
						<a class="cactus-link inline-block before:content-['#']" data-pagefind-filter={`tag:${tag}`} href={`/tags/${tag}/`}><span class="sr-only">查看更多带有此标签的文章&nbsp;</span>{tag}
						</a>{i < data.tags.length - 1 && ", "}
					</span>
				</>
			))}
		</div>
	)
}
{data.aiSummary && data.aiModel && <AiSummary summary={data.aiSummary} model={data.aiModel} />}
