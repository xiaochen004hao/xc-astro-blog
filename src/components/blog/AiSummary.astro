---
import { Icon } from "astro-icon/components";

interface Props {
	summary: string;
	model: string;
}

const { summary, model } = Astro.props;
const id = `ai-summary-${Math.random().toString(36).slice(2)}`;
---

<div
	id={id}
	class="ai-summary bg-global-text/5 relative mt-2 mb-6 rounded-lg p-4 pt-3"
	data-summary={summary}
	data-id={id}
	data-reveal
	data-reveal-delay="240"
>
	<div class="mb-2 flex items-center gap-2">
		<Icon aria-hidden="true" class="text-accent-2 h-4 w-4 shrink-0" name="lucide:sparkles" />
		<span class="text-accent-2 text-lg font-semibold tracking-wide uppercase"> AI 摘要 </span>
		<span
			class="text-muted bg-muted/10 ms-auto rounded-md px-2 py-0.5 text-[10px] leading-relaxed font-medium"
		>
			{model}
		</span>
	</div>
	<textarea
		id={`${id}-content`}
		class="ai-explanation block w-full resize-none border-0 bg-transparent text-sm leading-relaxed text-global-text outline-none"
		rows="4"
		readonly
		tabindex="-1"
		aria-label="AI 摘要内容"
	></textarea>
</div>

<style is:global>
	.ai-summary .ai-explanation {
		overflow-y: auto;
		max-height: 12rem;
	}
	.ai-summary .ai-explanation::after {
		content: "";
		display: inline-block;
		width: 8px;
		height: 2px;
		margin-left: 2px;
		background: var(--color-accent-2);
		vertical-align: bottom;
		animation: blink-underline 1s ease-in-out infinite;
		position: relative;
		bottom: 3px;
	}
	/* 打字完成后隐藏光标 */
	.ai-summary .ai-explanation[data-done="true"]::after {
		display: none;
	}
	/* 强制使用 W11 ibeam 光标（覆盖浏览器默认 I-beam） */
	.ai-summary .ai-explanation {
		cursor:
			url("/w11-cursor-concept-free/ibeam.cur") 11 17,
			text !important;
	}

	@keyframes blink-underline {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}
</style>

<script>
	(() => {
		const init = () => {
			const containers = document.querySelectorAll(".ai-summary");
			containers.forEach((container) => {
				const id = container.getAttribute("data-id");
				const text = container.getAttribute("data-summary");
				if (!id || !text) return;
				const contentEl = container.querySelector<HTMLTextAreaElement>(`#${id}-content`);
				if (!contentEl) return;

				// 防重入：避免 init 被同时触发两次（astro:page-load + readyState 检查）
				if (contentEl.dataset.typed === "true") return;
				contentEl.dataset.typed = "true";

				let index = 0;
				// 直接更新 textarea.value，不重建 DOM
				// textarea 固定高度（rows=4），内容增长不会导致滚动条变化
				const typeNext = () => {
					if (text && index < text.length) {
						index++;
						contentEl.value = text.slice(0, index);
						setTimeout(typeNext, 50);
					} else {
						// 打字完成，隐藏光标
						contentEl.dataset.done = "true";
					}
				};

				setTimeout(typeNext, 400);
			});
		};
		document.addEventListener("astro:page-load", init);
		if (document.readyState === "complete" || document.readyState === "interactive") {
			init();
		}
	})();
</script>
