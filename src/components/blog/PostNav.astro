---
import type { CollectionEntry } from "astro:content";

interface Props {
	nextPost?: CollectionEntry<"post"> | null | undefined;
	prevPost?: CollectionEntry<"post"> | null | undefined;
}

const { nextPost, prevPost } = Astro.props;
---

{
	(prevPost || nextPost) && (
		<nav class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2" data-reveal>
			{prevPost ? (
				<a
					href={`/posts/${prevPost.id}/`}
					class="group bg-global-text/5 hover:bg-accent/10 block rounded-lg p-4 transition-colors duration-200"
				>
					<span class="text-muted text-xs font-medium tracking-wider uppercase">← 上一篇</span>
					<p class="group-hover:text-accent mt-1 line-clamp-1 text-sm font-medium">
						{prevPost.data.title}
					</p>
				</a>
			) : (
				<div />
			)}
			{nextPost ? (
				<a
					href={`/posts/${nextPost.id}/`}
					class="group bg-global-text/5 hover:bg-accent/10 block rounded-lg p-4 text-right transition-colors duration-200"
				>
					<span class="text-muted text-xs font-medium tracking-wider uppercase">下一篇 →</span>
					<p class="group-hover:text-accent mt-1 line-clamp-1 text-sm font-medium">
						{nextPost.data.title}
					</p>
				</a>
			) : (
				<div />
			)}
		</nav>
	)
}
