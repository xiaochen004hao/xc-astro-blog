---
import "@waline/client/style";
import "../../styles/waline-custom.css";
---

<div class="mt-6 border-t pt-8">
	<div id="waline"></div>
</div>

<script>
	// Waline 评论服务地址
	const WALINE_SERVER = "https://waline.xc4h.qzz.io/";
	// Vditor 资源从本地加载（由 scripts/copy-vditor.mjs 复制到 public/vditor/dist/）
	// 避免从 CDN 加载时网络抖动导致 i18n/lute/icons 404 或编辑器加载失败
	const VDITOR_CDN = "/vditor/";

	// 运行时状态：Waline 实例、Vditor 实例、各 Observer 和事件监听器
	let walineInstance: { destroy?: () => void } | null = null;
	let walineInitPromise: Promise<void> | null = null;
	let vditorInstance: any = null;
	let vditorObserver: MutationObserver | null = null;
	let vditorContainer: HTMLElement | null = null;
	let currentTextarea: HTMLTextAreaElement | null = null;
	let themeObserver: MutationObserver | null = null;
	let submitListener: ((e: Event) => void) | null = null;

	// 读取当前站点主题（light / dark）
	function getCurrentTheme(): "light" | "dark" {
		return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
	}

	// 销毁所有实例和监听器（页面切换前调用，防止内存泄漏）
	function destroyAll() {
		if (vditorInstance) {
			try {
				vditorInstance.destroy?.();
			} catch {}
			vditorInstance = null;
		}
		if (vditorObserver) {
			vditorObserver.disconnect();
			vditorObserver = null;
		}
		if (themeObserver) {
			themeObserver.disconnect();
			themeObserver = null;
		}
		if (submitListener) {
			document.removeEventListener("click", submitListener, true);
			submitListener = null;
		}
		vditorContainer = null;
		currentTextarea = null;
		if (walineInstance?.destroy) {
			walineInstance.destroy();
			walineInstance = null;
		}
		const el = document.getElementById("waline");
		if (el) el.innerHTML = "";
	}

	// 预加载 Vditor CSS（只加一次，用 data 属性去重）
	function preloadVditorCss() {
		if (document.querySelector("link[data-vditor-css]")) return;
		const link = document.createElement("link");
		link.rel = "stylesheet";
		link.href = `${VDITOR_CDN}dist/index.css`;
		link.setAttribute("data-vditor-css", "");
		document.head.appendChild(link);
	}

	// 用 Vditor 替换 Waline 原生 textarea，实现所见即所得的 Markdown 编辑
	// 隐藏 Waline 原生操作栏（表情、图片上传、预览），Vditor 工具栏已替代
	function hideWalineOperation() {
		const walineEl = document.getElementById("waline");
		if (!walineEl) return;
		// 隐藏操作栏容器（表情、图片、预览按钮的父容器）
		const ops = walineEl.querySelectorAll<HTMLElement>(".wl-operation");
		ops.forEach((op) => {
			op.style.display = "none";
		});
		// 隐藏操作栏中的非提交按钮（兼容不同 Waline 版本的 DOM 结构）
		const btns = walineEl.querySelectorAll<HTMLElement>(
			".wl-header-item button, .wl-toolbar button",
		);
		btns.forEach((btn) => {
			if (!btn.classList.contains("primary")) btn.style.display = "none";
		});
	}

	// 加载表情包列表，供 Vditor IR 模式渲染 :前缀_表情名: 为图片
	// 表情包由 scripts/copy-vditor.mjs 下载到 public/emojis/{weibo,bilibili}/
	// 文件名格式：{prefix}{name}.{ext}（如 weibo_smile.png, bb_doge.png）
	// Lute 引擎规则：值包含 "." 则直接用作 <img src>，不拼接 emojiPath
	// 因此值必须是完整 URL，不能用文件名
	async function loadEmojiPack(packName: string): Promise<Record<string, string>> {
		const basePath = `/emojis/${packName}/`;
		try {
			const res = await fetch(`${basePath}info.json`);
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			const data = await res.json();
			const emojis: Record<string, string> = {};
			const ext = data.type || "png";
			const prefix = data.prefix || "";
			if (Array.isArray(data.items)) {
				for (const name of data.items) {
					// key 是 prefix+name（如 weibo_smile），值是完整 URL
					emojis[`${prefix}${name}`] = `${basePath}${prefix}${name}.${ext}`;
				}
			}
			return emojis;
		} catch (e) {
			console.warn(`表情包 ${packName} 本地加载失败，回退到 CDN`, e);
			return {};
		}
	}

	// 加载所有表情包并合并（B站小黄脸 + B站）
	async function loadAllEmojis() {
		const [bmoji, bilibili] = await Promise.all([
			loadEmojiPack("bmoji"),
			loadEmojiPack("bilibili"),
		]);
		return { ...bmoji, ...bilibili };
	}

	async function initVditor(textarea: HTMLTextAreaElement) {
		if (vditorInstance) return;

		preloadVditorCss();

		// 加载所有表情包（微博 + B站）
		const allEmojis = await loadAllEmojis();

		// 动态 import Vditor（约 500KB，懒加载不阻塞首屏）
		const { default: Vditor } = await import("vditor");

		// await 期间可能已被销毁，二次检查
		if (vditorInstance) return;

		// 在 textarea 后面插入 Vditor 容器，隐藏原生 textarea
		const container = document.createElement("div");
		container.className = "wl-vditor-wrapper";
		textarea.insertAdjacentElement("afterend", container);
		textarea.style.display = "none";
		textarea.setAttribute("aria-hidden", "true");

		// 保存引用，供 MutationObserver 检测位置变化时使用
		currentTextarea = textarea;
		vditorContainer = container;

		// syncing 标志：防止 Vditor ↔ textarea 双向同步死循环
		let syncing = false;

		// 比较新旧值，找出插入/删除的文本和位置
		function findDiff(oldText: string, newText: string) {
			let prefixLen = 0;
			while (
				prefixLen < oldText.length &&
				prefixLen < newText.length &&
				oldText[prefixLen] === newText[prefixLen]
			) {
				prefixLen++;
			}
			let suffixLen = 0;
			while (
				suffixLen < oldText.length - prefixLen &&
				suffixLen < newText.length - prefixLen &&
				oldText[oldText.length - 1 - suffixLen] === newText[newText.length - 1 - suffixLen]
			) {
				suffixLen++;
			}
			return {
				insertedText: newText.slice(prefixLen, newText.length - suffixLen),
				deletedText: oldText.slice(prefixLen, oldText.length - suffixLen),
			};
		}

		// 拦截 setRangeText：Waline 插入表情/图片时调用此方法
		const nativeSetRangeText = HTMLTextAreaElement.prototype.setRangeText;
		// 使用 any 类型绕过 TS 重载签名检查（原生 setRangeText 有两个重载，重写时无法完美匹配）
		textarea.setRangeText = function (
			replacement: string,
			start?: number,
			end?: number,
			selectionMode?: "select" | "start" | "end" | "preserve",
		) {
			if (!syncing && vditorInstance) {
				syncing = true;
				try {
					// 在 Vditor 当前光标位置插入，而非替换整个内容
					vditorInstance.insertValue?.(replacement);
				} catch {}
				syncing = false;
				return;
			}
			return nativeSetRangeText.call(textarea, replacement, start ?? 0, end ?? 0, selectionMode);
		} as typeof nativeSetRangeText;

		// 拦截 textarea 的 value setter：Waline 直接赋值时（插入表情/图片等）同步到 Vditor
		const nativeDescriptor = Object.getOwnPropertyDescriptor(
			HTMLTextAreaElement.prototype,
			"value",
		);
		if (nativeDescriptor?.get && nativeDescriptor?.set) {
			const nativeGetter = nativeDescriptor.get;
			const nativeSetter = nativeDescriptor.set;
			Object.defineProperty(textarea, "value", {
				get() {
					return nativeGetter.call(this);
				},
				set(newValue: string) {
					// 先获取旧值，再设置新值（顺序不能反）
					const oldValue = nativeGetter.call(this);
					nativeSetter.call(this, newValue);
					// syncing=true 时是 Vditor 触发的赋值，不需要回写
					if (!syncing && vditorInstance) {
						syncing = true;
						try {
							const diff = findDiff(oldValue, newValue);
							if (diff.insertedText && !diff.deletedText) {
								// 纯插入操作：在 Vditor 光标位置插入差异文本
								vditorInstance.insertValue?.(diff.insertedText);
							} else {
								// 复杂变化（删除+插入）：fallback 到 setValue
								vditorInstance.setValue?.(newValue);
							}
						} catch {}
						syncing = false;
					}
				},
				configurable: true,
			});
		}

		const theme = getCurrentTheme();

		vditorInstance = new Vditor(container, {
			height: 240,
			minHeight: 180,
			mode: "ir",
			theme: theme === "dark" ? "dark" : "classic",
			cdn: VDITOR_CDN,
			toolbar: [
				"emoji",
				"headings",
				"bold",
				"italic",
				"|",
				"link",
				"list",
				"ordered-list",
				"check",
				"quote",
				"line",
				"|",
				"code",
				"inline-code",
				"upload",
				"|",
				"undo",
				"redo",
				"|",
				"fullscreen",
			],
			toolbarConfig: { pin: true },
			cache: { enable: false },
			counter: { enable: true, type: "markdown", max: 2000 },
			placeholder: "支持 Markdown 语法，说点什么吧…",
			preview: { delay: 300, hljs: { style: theme === "dark" ? "github-dark" : "github" } },
			comment: { enable: false },
			hint: { emoji: allEmojis, emojiPath: "/emojis/" },
			// 图片上传：上传到 Waline 服务器，返回 URL 后插入到 Vditor
			upload: {
				accept: "image/*",
				multiple: false,
				handler: (files: File[]) => {
					const file = files[0];
					if (!file) return null;
					const formData = new FormData();
					formData.append("file", file);
					fetch(`${WALINE_SERVER}api/media`, {
						method: "POST",
						body: formData,
					})
						.then((res) => res.json())
						.then((data: any) => {
							if (data.errno === 0 && data.data?.url) {
								vditorInstance?.insertValue(`\n![](${data.data.url})\n`);
							} else {
								console.error("图片上传失败", data);
							}
						})
						.catch((err) => console.error("图片上传失败", err));
					return null;
				},
			},
			// Vditor 内容变化时同步到隐藏的 textarea，并触发 input 事件让 Waline 感知
			input: (value: string) => {
				syncing = true;
				textarea.value = value;
				textarea.dispatchEvent(new Event("input", { bubbles: true }));
				syncing = false;
			},
			after: () => {
				// 编辑器初始化完成后，如果 textarea 已有内容（如编辑回复），回填到 Vditor
				if (textarea.value) {
					syncing = true;
					vditorInstance?.setValue?.(textarea.value);
					syncing = false;
				}
				// 隐藏 Waline 原生操作栏（表情、图片上传、预览），Vditor 工具栏已替代
				hideWalineOperation();
			},
		});

		// 监听站点明暗主题切换，同步更新 Vditor 主题
		themeObserver = new MutationObserver(() => {
			if (!vditorInstance) return;
			const newTheme = getCurrentTheme();
			try {
				vditorInstance.setTheme?.(
					newTheme === "dark" ? "dark" : "classic",
					newTheme === "dark" ? "dark" : "classic",
					newTheme === "dark" ? "github-dark" : "github",
				);
			} catch {}
		});
		themeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["data-theme"],
		});

		// 拦截 Waline 提交按钮点击：提交前强制同步内容到 textarea，提交后清空编辑器
		submitListener = (e: Event) => {
			const target = e.target as HTMLElement;
			if (target.classList?.contains("wl-btn") && target.classList.contains("primary")) {
				if (vditorInstance) {
					syncing = true;
					textarea.value = vditorInstance.getValue?.() || "";
					textarea.dispatchEvent(new Event("input", { bubbles: true }));
					syncing = false;
				}
				// 延迟 600ms 清空，等 Waline 提交请求完成
				setTimeout(() => {
					if (vditorInstance && !textarea.value) {
						vditorInstance.setValue?.("");
					}
				}, 600);
			}
		};
		document.addEventListener("click", submitListener, true);
	}

	// 等待 Waline 渲染出原生 textarea 后，用 Vditor 替换它
	// 同时持续监听 DOM 变化，处理 Waline "回复/取消回复" 操作时 textarea 被移动的情况
	function watchForEditor() {
		const existing = document.querySelector<HTMLTextAreaElement>(".wl-editor");
		if (existing && !vditorInstance) {
			initVditor(existing);
		}

		// 持续监听 #waline 的 DOM 变化，处理：
		// 1. textarea 被移动到回复位置 → Vditor 容器跟着移动
		// 2. textarea 被销毁/重新创建 → 销毁旧 Vditor，初始化新 Vditor
		// 3. textarea 的 display 被重置 → 重新隐藏
		// 用 rAF 防抖，避免 Waline 频繁更新评论列表时过度触发
		let rafId: number | null = null;
		vditorObserver = new MutationObserver(() => {
			if (rafId !== null) return;
			rafId = requestAnimationFrame(() => {
				rafId = null;
				handleDomChange();
			});
		});

		function handleDomChange() {
			// 情况 A：Vditor 还未初始化，检查是否有 textarea 可用
			if (!vditorInstance) {
				const textarea = document.querySelector<HTMLTextAreaElement>(".wl-editor");
				if (textarea) {
					initVditor(textarea);
				}
				return;
			}

			// 情况 B：Vditor 已初始化，检查 textarea 是否还在 DOM 中
			if (!currentTextarea || !document.body.contains(currentTextarea)) {
				const newTextarea = document.querySelector<HTMLTextAreaElement>(".wl-editor");
				if (newTextarea && newTextarea !== currentTextarea) {
					// 销毁旧 Vditor，用新 textarea 重新初始化
					try {
						vditorInstance.destroy?.();
					} catch {}
					vditorInstance = null;
					vditorContainer?.remove();
					vditorContainer = null;
					initVditor(newTextarea);
				}
				return;
			}

			// 情况 C：textarea 还在，确保 Vditor 容器紧跟其后
			if (vditorContainer && vditorContainer !== currentTextarea.nextElementSibling) {
				currentTextarea.insertAdjacentElement("afterend", vditorContainer);
			}

			// 情况 D：textarea 的 display 可能被 Waline 重置，重新隐藏
			if (currentTextarea.style.display !== "none") {
				currentTextarea.style.display = "none";
			}
		}
		vditorObserver.observe(document.getElementById("waline") || document.body, {
			childList: true,
			subtree: true,
			attributes: true,
			attributeFilter: ["style", "class"],
		});
	}

	// 初始化 Waline 评论系统
	async function walineInit() {
		const el = document.getElementById("waline");
		if (!el) return;

		// 防止重复初始化（View Transitions 可能多次触发 page-load）
		if (!walineInitPromise) {
			walineInitPromise = import("@waline/client")
				.then(({ init }) => {
					walineInstance = init({
						el: "#waline",
						serverURL: WALINE_SERVER,
						path: window.location.pathname,
						lang: "zh-CN",
						dark: '[data-theme="dark"]',
						emoji: ["/emojis/bmoji", "/emojis/bilibili"],
						meta: ["nick", "mail", "link"],
						requiredMeta: ["nick"],
						pageSize: 10,
					});
					// Waline 渲染完成后，延迟 100ms 开始监听编辑器出现
					setTimeout(watchForEditor, 100);
				})
				.finally(() => {
					walineInitPromise = null;
				});
		}

		await walineInitPromise;
	}

	// 延迟加载评论区：当评论区容器接近视口时才初始化 Waline
	// 避免页面切换动画期间加载 Waline/Vditor 导致卡顿
	let lazyObserver: IntersectionObserver | null = null;

	function setupLazyLoad() {
		const el = document.getElementById("waline");
		if (!el) return;

		// 已初始化或正在初始化，跳过
		if (walineInitPromise || walineInstance) return;

		// 不支持 IntersectionObserver：延迟 1s 后初始化
		if (!("IntersectionObserver" in window)) {
			setTimeout(walineInit, 1000);
			return;
		}

		// 评论区距离视口 300px 时触发初始化（提前加载，用户滚动到时已就绪）
		lazyObserver = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					lazyObserver?.disconnect();
					lazyObserver = null;
					// 延迟到浏览器空闲时再加载，确保页面切换动画（1.5s）完成且主线程空闲
					// 短文章评论区在视口内，不加这个延迟会和动画一起执行导致卡顿
					const idleCb =
						window.requestIdleCallback ||
						((cb: IdleRequestCallback) => setTimeout(cb, 1600));
					idleCb(() => walineInit(), { timeout: 3000 });
				}
			},
			{ rootMargin: "300px" },
		);
		lazyObserver.observe(el);
	}

	// 生命周期：页面加载时设置延迟加载，页面切换前销毁
	document.addEventListener("astro:before-swap", () => {
		if (lazyObserver) {
			lazyObserver.disconnect();
			lazyObserver = null;
		}
		destroyAll();
	});
	document.addEventListener("astro:page-load", setupLazyLoad);
</script>
